airbnb["Price(in dollar)"].dtype


airbnb["Price(in dollar)"].head(10)


airbnb["Price(in dollar)"] = (
    airbnb["Price(in dollar)"]
    .astype(str)
    .str.replace(",", "", regex=False)
    .str.replace("$", "", regex=False)
    .str.strip()
)

airbnb["Price(in dollar)"] = pd.to_numeric(
    airbnb["Price(in dollar)"],
    errors="coerce"
)


