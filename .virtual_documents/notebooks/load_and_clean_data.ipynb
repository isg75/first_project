# Check the result
airbnb.info()


import pandas as pd

# Replace blank strings with NaN
airbnb[["Country", "Rating", "Reviews"]] = (
    airbnb[["Country", "Rating", "Reviews"]]
    .replace(r'^\s*$', pd.NA, regex=True)
)

# Remove rows with missing values
airbnb = airbnb.dropna(subset=["Country", "Rating", "Reviews"])

# Reset the index
airbnb.reset_index(drop=True, inplace=True)


airbnb[["Country", "Rating", "Reviews"]].isnull().sum()


pd.set_option("display.max_rows", None)
pd.set_option("display.max_columns", None)

display(airbnb)


# Rename columns
airbnb.rename(columns={
    "Title": "Property Name",
    "Detail": "Amenities",
    "BnB_Type": "Property Type",
    "Reviews": "Number of Reviews"
}, inplace=True)

# Check the updated columns
airbnb.columns.tolist()


display(airbnb.head())


airbnb = airbnb.sort_values(
    by=["Rating", "Number of Reviews"],
    ascending=[False, False]
)

airbnb["Rating Rank"] = range(1, len(airbnb) + 1)

airbnb.head(20)





# Create Price Rank (Highest Price = Rank 1)
airbnb["Price Rank"] = airbnb["Price(in dollar)"].rank(
    ascending=False,
    method="dense"
).astype(int)

# Sort from highest price to lowest
airbnb = airbnb.sort_values(
    by="Price(in dollar)",
    ascending=False
)

# Display the result
airbnb.head(20)


airbnb["Property Name"].duplicated().sum()


airbnb[
    airbnb.duplicated(
        subset=["Property Name", "Country"],
        keep=False
    )
].sort_values(["Property Name", "Country"])


duplicates = airbnb[
    airbnb.duplicated(
        subset=["Property Name"],
        keep=False
    )
].sort_values("Property Name")

duplicates


