    "def classify_main_genre(genre_val):\n",
    "    \n",
    "    genre_str = str(genre_val).lower()\n",
    "    \n",
    "    # if empyt, or '[]'\n",
    "    if pd.isna(genre_val) or genre_val == 'N/A' or genre_val == '[]':\n",
    "        return pd.NA\n",
    "    # Keyword search within the line (if any match, this will be the category)\n",
    "    if \"hip hop\" in genre_str or \"rap\" in genre_str or \"trap\" in genre_str or \"drill\" in genre_str:\n",
    "        return \"hip-hop / rap\"\n",
    "    elif \"pop\" in genre_str:\n",
    "        return \"pop\"\n",
    "    elif \"rock\" in genre_str or \"metal\" in genre_str or \"grunge\" in genre_str or \"punk\" in genre_str:\n",
    "        return \"rock / metal\"\n",
    "    elif \"latin\" in genre_str or \"reggaeton\" in genre_str or \"corridos\" in genre_str or \"sierraño\" in genre_str:\n",
    "        return \"latin\"\n",
    "    elif \"edm\" in genre_str or \"house\" in genre_str or \"techno\" in genre_str or \"electro\" in genre_str or \"trance\" in genre_str or \"phonk\" in genre_str:\n",
    "        return \"electronic / edm\"\n",
    "    elif \"r&b\" in genre_str or \"soul\" in genre_str:\n",
    "        return \"r&b / soul\"\n",
    "    elif \"indie\" in genre_str or \"alternative\" in genre_str or \"folk\" in genre_str:\n",
    "        return \"indie / alternative\"\n",
    "    elif \"classical\" in genre_str or \"ambient\" in genre_str or \"instrumental\" in genre_str:\n",
    "        return \"classical / instrumental\"\n",
    "    elif \"country\" in genre_str or \"acoustic country\" in genre_str :\n",
    "        return \"country\"\n",
    "    elif \"soundtrack\" in genre_str or \"anime\" in genre_str :\n",
    "        return \"soundtrack\"    \n",
    "    else:\n",
    "        return \"other / niche\""
   ]
